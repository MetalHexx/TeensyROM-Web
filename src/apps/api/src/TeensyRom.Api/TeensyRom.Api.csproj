<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>1.0.0-alpha.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- OpenAPI generation disabled in CI to avoid platform-specific binary execution issues -->
    <OpenApiGenerateDocuments Condition="'$(SkipOpenApiGeneration)' != 'true'">true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(OutputPath)api-spec</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(SkipOpenApiGeneration)' != 'true'">true</OpenApiGenerateDocumentsOnBuild>
    <!-- Self-contained single-file publishing configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Don't include all content in single file - keep Assets as separate files -->
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="RadEndpoints" Version="1.0.0-alpha.21" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeensyRom.Core.Device\TeensyRom.Core.Device.csproj" />
    <ProjectReference Include="..\TeensyRom.Core.Serial\TeensyRom.Core.Serial.csproj" />
    <ProjectReference Include="..\TeensyRom.Core.Storage\TeensyRom.Core.Storage.csproj" />
    <ProjectReference Include="..\TeensyRom.Core\TeensyRom.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ClientApp\" />
    <Folder Include="Endpoints\Common\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ClientApp\teensyrom-nx\dist\**" />
    <Compile Remove="Endpoints\Serial\LogHub\**" />
    <Compile Remove="Endpoints\Serial\StopLogs\**" />
    <Content Remove="ClientApp\teensyrom-nx\dist\**" />
    <Content Remove="Endpoints\Serial\LogHub\**" />
    <Content Remove="Endpoints\Serial\StopLogs\**" />
    <EmbeddedResource Remove="Endpoints\Serial\LogHub\**" />
    <EmbeddedResource Remove="Endpoints\Serial\StopLogs\**" />
    <None Remove="ClientApp\teensyrom-nx\dist\**" />
    <None Remove="Endpoints\Serial\LogHub\**" />
    <None Remove="Endpoints\Serial\StopLogs\**" />
  </ItemGroup>

  <!-- Build and copy frontend before publish -->
  <Target Name="BuildFrontend" BeforeTargets="Publish" Condition="'$(Configuration)' == 'Release' AND '$(SkipBuildFrontend)' != 'true'">
    <PropertyGroup>
      <WorkspaceRoot>$(MSBuildProjectDirectory)\..\..\..\..</WorkspaceRoot>
      <FrontendScript>$(WorkspaceRoot)\scripts\copy-frontend.ps1</FrontendScript>
    </PropertyGroup>
    <Message Text="Building Angular frontend..." Importance="high" />
    <Exec Command="pwsh -File &quot;$(FrontendScript)&quot;" WorkingDirectory="$(WorkspaceRoot)" />
  </Target>

  <!-- Include Assets from TeensyRom.Core build output for publishing -->
  <Target Name="IncludeCoreAssets" AfterTargets="Build">
    <ItemGroup>
      <CoreAssets Include="$(MSBuildProjectDirectory)\..\TeensyRom.Core\bin\$(Configuration)\$(TargetFramework)\Assets\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\TeensyRom.Core\bin\$(Configuration)\$(TargetFramework)\Assets\**\*.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(CoreAssets)" DestinationFolder="$(OutDir)Assets\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Ensure Assets are included in publish output -->
  <Target Name="PublishCoreAssets" AfterTargets="Publish">
    <ItemGroup>
      <CoreAssetsForPublish Include="$(OutDir)Assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CoreAssetsForPublish)" DestinationFolder="$(PublishDir)Assets\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
