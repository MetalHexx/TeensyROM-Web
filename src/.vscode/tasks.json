{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ensure Dependencies Installed",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/.vscode/ensure-deps.mjs"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Ensure SIDablist Ready",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/.vscode/ensure-sidablist.mjs"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Serve Frontend",
      "type": "npm",
      "script": "start",
      "dependsOn": ["Ensure Dependencies Installed", "Ensure SIDablist Ready"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": {
        "focus": true,
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": ["relative", "${cwd}"],
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Local:   http://localhost:4200/"
        }
      }
    }
  ]
}
