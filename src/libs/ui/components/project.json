{
  "name": "ui-components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/components/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../coverage/libs/ui/components",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/ui/components/.storybook",
        "browserTarget": "ui-components:build-storybook",
        "compodoc": true,
        "compodocArgs": ["-p", "libs/ui/components/tsconfig.lib.json", "-e", "json"],
        "styles": ["libs/ui/styles/src/lib/theme/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/styles/src/lib"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ui-components",
        "configDir": "libs/ui/components/.storybook",
        "browserTarget": "ui-components:build-storybook",
        "compodoc": true,
        "compodocArgs": ["-p", "libs/ui/components/tsconfig.lib.json", "-e", "json"],
        "styles": ["libs/ui/styles/src/lib/theme/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/styles/src/lib"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "ui-components:build-storybook",
        "staticFilePath": "dist/storybook/ui-components",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ui-components:build-storybook:ci"
        }
      }
    }
  }
}
